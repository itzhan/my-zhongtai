# 运维中台后端配置。复制为 .env 后填写；.env 不入库。
PORT=3400
# 管理密码与会话签名密钥
APP_PASSWORD=
SESSION_SECRET=
# Google Authenticator TOTP 2FA 密钥（Base32，留空则不启用 2FA）
TOTP_SECRET=
# sub2api 管理 API
SUB2API_BASE=http://sub2api-8082:8080/api/v1
SUB2API_ADMIN_KEY=
# sub2api 的 Postgres（只读角色）
PG_HOST=sub2api-8082-postgres
PG_PORT=5432
PG_USER=
PG_PASSWORD=
PG_DB=sub2api
# 11.6 之前用量的独立历史库（可选，不配则账单只查现网）。与 8082 无关。
# PG_HIST_HOST=host.docker.internal
# PG_HIST_PORT=5435
# PG_HIST_USER=hist
# PG_HIST_PASSWORD=
# PG_HIST_DB=sub2api_hist
# PG_HIST_UNTIL=2026-11-06T00:00:00.000Z
DATA_DIR=/app/data
# 只读保护：默认 1（不写线上 sub2api、调度只观察）；线上正式运行设为 0
READONLY=1
